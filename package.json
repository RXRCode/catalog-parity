{
  "name": "@rxrcode/catalog-parity",
  "version": "0.1.2",
  "description": "Compare commerce catalog exports before migrations and integrations go live.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "catalog-parity": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test:package": "node scripts/package-smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "prepublishOnly": "npm run check",
    "prepare": "npm run build",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "security": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ecommerce",
    "catalog",
    "migration",
    "data-quality",
    "csv",
    "json",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "RXR Code",
    "url": "https://rxrcode.dev"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RXRCode/catalog-parity.git"
  },
  "homepage": "https://rxrcode.dev/open-source/catalog-parity",
  "bugs": {
    "url": "https://github.com/RXRCode/catalog-parity/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "csv-parse": "^7.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
